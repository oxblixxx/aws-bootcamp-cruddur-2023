#! /usr/bin/bash 
# Resolve the absolute path to the schema.sql file so it can be reliably referenced,
# regardless of the current working directory.
schema_path="$(realpath ../..)/db/schema.sql"

echo $schema_path
echo "db-schema-load"

if [ "$1" == "prod" ]; then
    echo "using production db"
    URL=$PROD_CONNECTION_URL
else 
    echo "using development db"
    URL=$LOCAL_CONNECTION_URL
fi

# Run psql with connection string and schema file
psql "$URL" -f "$schema_path"
