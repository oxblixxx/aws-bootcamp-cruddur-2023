#! /usr/bin/env bash

CYAN='\033[1;36m'
NO_COLOR='\033[0m'
LABEL="db-drop"

printf "${CYAN}== ${LABEL}${NO_COLOR}\n"

DB_NAME="cruddur"

NO_DB_CONNECTION_URL=$(echo "$CONNECTION_URL" | sed "s|/$DB_NAME||")

echo "Using connection: $NO_DB_CONNECTION_URL"

# Check if DB exists
DB_EXISTS=$(psql "$NO_DB_CONNECTION_URL" -tAc "SELECT 1 FROM pg_database WHERE datname='$DB_NAME'")

if [ "$DB_EXISTS" = "1" ]; then
  echo "Database '$DB_NAME' exists. Dropping..."
  psql "$NO_DB_CONNECTION_URL" -c "DROP DATABASE $DB_NAME;"
else
  echo "Database '$DB_NAME' does not exist. Skipping drop."
fi