#!/bin/bash

#set -e

# Get repo root (3 levels up from backend-flask/bin/task)
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"

SERVICE="$1"

if [ -z "$SERVICE" ]; then
    echo "Usage: $0 <backend-flask|frontend-react>"
    exit 1
fi

TASK_FILE="$ROOT_DIR/aws/service/${SERVICE}.json"

if [ ! -f "$TASK_FILE" ]; then
    echo "Task definition not found: $TASK_FILE"
    exit 1
fi

echo "Using task definition: $TASK_FILE"

aws ecs create-service \
    --cli-input-json "file://$TASK_FILE"