#!/bin/bash

set -euo pipefail

# ==========================================================
# Get project root and load .env
# ==========================================================
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
#ENV_FILE="$ROOT_DIR/.env"
ECS_CLUSTER="cruddur"

# ==========================================================
# Validate arguments
# ==========================================================
if [ $# -ne 1 ]; then
    echo "Usage: $0 <desired-count>"
    echo
    echo "Examples:"
    echo "  $0 0"
    echo "  $0 1"
    echo "  $0 2"
    exit 1
fi

DESIRED_COUNT="$1"

if ! [[ "$DESIRED_COUNT" =~ ^[0-9]+$ ]]; then
    echo "Error: desired count must be a non-negative integer."
    exit 1
fi

# ==========================================================
# Configuration
# ==========================================================
SERVICES=(
    "backend-flask"
    "frontend-react"
)

if [ -z "${ECS_CLUSTER:-}" ]; then
    echo "ECS_CLUSTER is not set in .env"
    exit 1
fi

# ==========================================================
# Update services
# ==========================================================
for SERVICE in "${SERVICES[@]}"; do
    echo "Updating '$SERVICE' to desired count: $DESIRED_COUNT"

    aws ecs update-service \
        --cluster "$ECS_CLUSTER" \
        --service "$SERVICE" \
        --desired-count "$DESIRED_COUNT"

    echo "✓ Updated $SERVICE"
    echo
done

echo "========================================"
echo "✅ All services updated to desired count: $DESIRED_COUNT"
