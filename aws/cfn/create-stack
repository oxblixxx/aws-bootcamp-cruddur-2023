#!/usr/bin/env bash

#set -e
## CREATE A STACK
## ./create-stack <resource-directory>

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"

CFN_DIR="$PROJECT_ROOT/aws/cfn/$1"

read -p "Enter CloudFormation template filename: " TEMPLATE_FILE

# Automatically append .yaml if it was not provided
if [[ "$TEMPLATE_FILE" != *.yaml ]]; then
  TEMPLATE_FILE="${TEMPLATE_FILE}.yaml"
fi

CFN_PATH="$CFN_DIR/$TEMPLATE_FILE"
CONFIG_PATH="$CFN_DIR/config.toml"
REGION="us-east-1"

# Remove .yaml from the filename to create the stack name
STACK_NAME="${TEMPLATE_FILE%.yaml}"

echo "CFN directory: $CFN_DIR"
echo "Template: $CFN_PATH"
echo "Config: $CONFIG_PATH"
echo "Stack: $STACK_NAME"

# Check that the template exists
if [[ ! -f "$CFN_PATH" ]]; then
  echo "ERROR: CloudFormation template not found: $CFN_PATH"
  exit 1
fi

cfn-lint "$CFN_PATH"

#BUCKET=$(cfn-toml key deploy.bucket -t "$CONFIG_PATH")
#REGION=$(cfn-toml key deploy.region -t "$CONFIG_PATH")
#STACK_NAME=$(cfn-toml key deploy.stack_name -t "$CONFIG_PATH")
#  --s3-bucket "$BUCKET" \
#  --s3-prefix "$1" \

aws cloudformation deploy \
  --stack-name "$STACK_NAME" \
  --region "$REGION" \
  --template-file "$CFN_PATH" \
  --no-execute-changeset \
  --tags group="cruddur-$1" \
  --capabilities CAPABILITY_NAMED_IAM

echo "done"