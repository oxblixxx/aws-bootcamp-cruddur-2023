#!/bin/bash

#############################################################
# AWS Application Load Balancer Deployment Script
#
# Usage:
#   ./create-alb.sh dev
#   ./create-alb.sh prod
#
# Environments
#   dev
#     - Listener :3000 -> Frontend Target Group
#     - Listener :4567 -> Backend Target Group
#
#   prod
#     - HTTP 80  -> Redirect to HTTPS 443
#     - HTTPS 443 -> Frontend Target Group (Default)
#     - Frontend Host : cruddur.mustaphaops.online
#       -> Frontend Target Group (Default)
#     - Backend Host  : api.mustaphaops.online
#     - Host Header:
#         api.mustaphaops.online
#       -> Backend Target Group (Priority 10)
#############################################################
# Also this script assumes that you have already created the following ACM certificate in the us-east-1 region:
#  - *.mustaphaops.online
# Also this script assumes that you have already created the following Route53 hosted zone:

# Uncomment to stop execution whenever a command fails
set -e

#############################################################
# Deployment Environment
#
# Defaults to "dev" if no argument is supplied.
#
# Example:
#   ./create-alb.sh
#   ./create-alb.sh prod
#############################################################
if [[ $# -ne 1 ]]; then
    echo "Usage: $0 {dev|prod}"
    exit 1
fi

ENVIRONMENT="$1"

case "$ENVIRONMENT" in
    dev)
        echo "Creating Development environment..."
        echo "  - Frontend Listener :3000"
        echo "  - Backend Listener  :4567"
        ;;
    prod)
        echo "Creating Production environment..."
        echo "  - HTTP  :80  -> Redirect to HTTPS"
        echo "  - HTTPS :443"
        echo "  - Frontend Host : cruddur.mustaphaops.online"
        echo "  - Backend Host  : api.mustaphaops.online"
        ;;
    *)
        echo "Invalid environment: $ENVIRONMENT"
        echo "Usage: $0 {dev|prod}"
        exit 1
        ;;
esac
#ENVIRONMENT="${1:-dev}"

#############################################################
# Resource Names
#############################################################
ALB_NAME="cruddur-alb"
ALB_SG_NAME="crudur-alb-sg"

BACKEND_TG_NAME="backend-flask-tg"
FRONTEND_TG_NAME="frontend-flask-tg"

#############################################################
# Production ACM Certificate
#
# Used only for the HTTPS (443) listener.
#############################################################
CERTIFICATE_ARN="arn:aws:acm:us-east-1:193654356005:certificate/edb389be-6bbd-4536-bc22-d4f17109a160"

#############################################################
# Backend API Host
#
# Requests to this hostname are routed to the backend target
# group.
#############################################################
API_HOST="api.mustaphaops.online"
FRONTEND_HOST="cruddur.mustaphaops.online"
#############################################################
# Application Ports
#############################################################
BACKEND_APP_PORT=4567
FRONTEND_APP_PORT=3000

#############################################################
# ROUTE 53
#############################################################
HOSTED_ZONE_NAME=mustaphaops.online

#############################################################
# Fetch Default VPC
#############################################################
VPC_ID=$(aws ec2 describe-vpcs \
    --filters Name=is-default,Values=true \
    --query 'Vpcs[0].VpcId' \
    --output text)

#############################################################
# Fetch all subnets from the Default VPC
#
# These are used when creating the Application Load Balancer.
#############################################################
read -ra SUBNETS <<< "$(
aws ec2 describe-subnets \
    --filters Name=vpc-id,Values=$VPC_ID \
    --query 'Subnets[*].SubnetId' \
    --output text
)"

#############################################################
# Create or Reuse the ALB Security Group
#############################################################
SG=$(aws ec2 describe-security-groups \
    --filters \
        Name=vpc-id,Values=$VPC_ID \
        Name=group-name,Values=$ALB_SG_NAME \
    --query 'SecurityGroups[0].GroupId' \
    --output text 2>/dev/null || true)

