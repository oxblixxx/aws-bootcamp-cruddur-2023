#     echo "Creating Security Group..."

#     SG=$(aws ec2 create-security-group \
#         --group-name "$ALB_SG_NAME" \
#         --description "ALB Security Group" \
#         --vpc-id "$VPC_ID" \
#         --query GroupId \
#         --output text)

#     #########################################################
#     # Allow HTTP
#     #########################################################
#     aws ec2 authorize-security-group-ingress \
#         --group-id "$SG" \
#         --protocol tcp \
#         --port 80 \
#         --cidr 0.0.0.0/0 || true

#     #########################################################
#     # Allow HTTPS
#     #########################################################
#     aws ec2 authorize-security-group-ingress \
#         --group-id "$SG" \
#         --protocol tcp \
#         --port 443 \
#         --cidr 0.0.0.0/0 || true

#     #########################################################
#     # Development Listener Ports
#     #########################################################
#     aws ec2 authorize-security-group-ingress \
#         --group-id "$SG" \
#         --protocol tcp \
#         --port 3000 \
#         --cidr 0.0.0.0/0 || true

#     aws ec2 authorize-security-group-ingress \
#         --group-id "$SG" \
#         --protocol tcp \
#         --port 4567 \
#         --cidr 0.0.0.0/0 || true
# fi

#############################################################
# Create or Reuse Application Load Balancer
#############################################################
ALB=$(aws elbv2 describe-load-balancers \
    --names "$ALB_NAME" \
    --query 'LoadBalancers[0].LoadBalancerArn' \
    --output text 2>/dev/null || true)

if [[ -z "$ALB" || "$ALB" == "None" ]]; then

    echo "Creating Application Load Balancer..."

    ALB=$(aws elbv2 create-load-balancer \
        --name "$ALB_NAME" \
        --type application \
        --scheme internet-facing \
        --subnets "${SUBNETS[@]}" \
        --security-groups "$SG" \
        --query 'LoadBalancers[0].LoadBalancerArn' \
        --output text)
fi

#############################################################
# Fetch ALB DNS Name
#############################################################
ALB_DNS=$(aws elbv2 describe-load-balancers \
    --load-balancer-arns "$ALB" \
    --query 'LoadBalancers[0].DNSName' \
    --output text)

#############################################################
# Function:
# Create Target Group if it doesn't exist.
#############################################################
create_tg() {

    local NAME=$1
    local PORT=$2
    local HEALTH_CHECK=$3

    local ARN=$(aws elbv2 describe-target-groups \
        --names "$NAME" \
        --query 'TargetGroups[0].TargetGroupArn' \
        --output text 2>/dev/null || true)

    if [[ -z "$ARN" || "$ARN" == "None" ]]; then

        echo "Creating Target Group: $NAME"

        ARN=$(aws elbv2 create-target-group \
            --name "$NAME" \
            --protocol HTTP \
            --port "$PORT" \
            --target-type ip \
            --vpc-id "$VPC_ID" \
            --health-check-path "$HEALTH_CHECK" \
            --query 'TargetGroups[0].TargetGroupArn' \
            --output text)
    fi

    echo "$ARN"
}

#############################################################
# Backend Target Group
#############################################################
BACKEND_TG=$(create_tg \
    "$BACKEND_TG_NAME" \
    "$BACKEND_APP_PORT" \
    "/api/health-check")

#############################################################
# Frontend Target Group
#############################################################
FRONTEND_TG=$(create_tg \
    "$FRONTEND_TG_NAME" \
    "$FRONTEND_APP_PORT" \
    "/")

#############################################################
# Production Deployment
#############################################################
if [[ "$ENVIRONMENT" == "prod" ]]; then

    #########################################################
    # HTTP Listener (80)
    #
    # Redirect all traffic to HTTPS.
    #########################################################
    H80=$(aws elbv2 describe-listeners \
        --load-balancer-arn "$ALB" \
        --query 'Listeners[?Port==`80`].ListenerArn|[0]' \
        --output text)

    if [[ "$H80" == "None" ]]; then

        aws elbv2 create-listener \
            --load-balancer-arn "$ALB" \
            --protocol HTTP \
            --port 80 \
            --default-actions \
            Type=redirect,RedirectConfig='{Protocol=HTTPS,Port="443",StatusCode=HTTP_301}'
    fi

    #########################################################
    # HTTPS Listener (443)
    #
    # Default action forwards requests to the Frontend
    # Target Group.
    #########################################################
    H443=$(aws elbv2 describe-listeners \
        --load-balancer-arn "$ALB" \
        --query 'Listeners[?Port==`443`].ListenerArn|[0]' \
        --output text)

    if [[ "$H443" == "None" ]]; then

        H443=$(aws elbv2 create-listener \
            --load-balancer-arn "$ALB" \
            --protocol HTTPS \
            --port 443 \
            --certificates CertificateArn="$CERTIFICATE_ARN" \
            --ssl-policy ELBSecurityPolicy-TLS13-1-2-2021-06 \
            --default-actions Type=forward,TargetGroupArn="$FRONTEND_TG" \
            --query 'Listeners[0].ListenerArn' \
            --output text)
    fi

    #########################################################
    # Listener Rule
    #
    # Priority : 10
    #
    # Host:
    #   api.mustaphaops.online
    #
    # Forward:
    #   Backend Target Group
    #########################################################
    RULE=$(aws elbv2 describe-rules \
        --listener-arn "$H443" \
        --query "Rules[?Priority=='10'].RuleArn|[0]" \
        --output text)

    if [[ "$RULE" == "None" ]]; then

        aws elbv2 create-rule \
            --listener-arn "$H443" \
            --priority 10 \
            --conditions \
            Field=host-header,HostHeaderConfig="{Values=[$API_HOST]}" \
            --actions \
            Type=forward,TargetGroupArn="$BACKEND_TG"
    fi

#############################################################
# Development Deployment
#############################################################
else

    #########################################################
    # Create:
    #
    # 3000 -> Frontend Target Group
    # 4567 -> Backend Target Group
    #########################################################
    for P in 3000 4567; do

        L=$(aws elbv2 describe-listeners \
            --load-balancer-arn "$ALB" \
            --query "Listeners[?Port==\`$P\`].ListenerArn|[0]" \
            --output text)

        if [[ "$L" == "None" ]]; then

            TG=$FRONTEND_TG

            [[ "$P" == "4567" ]] && TG=$BACKEND_TG

            aws elbv2 create-listener \
                --load-balancer-arn "$ALB" \
                --protocol HTTP \
                --port "$P" \
                --default-actions \
                Type=forward,TargetGroupArn="$TG" >/dev/null
        fi
    done
fi

echo "Updating Route53 records..."

# Get Hosted Zone ID
HOSTED_ZONE_ID=$(aws route53 list-hosted-zones-by-name \
    --dns-name "$HOSTED_ZONE_NAME" \
    --query 'HostedZones[0].Id' \
    --output text)

# Route53 returns /hostedzone/XXXXXXXX
echo HOSTED_ZONE_ID="${HOSTED_ZONE_ID##*/}"

# Get ALB DNS Name and Canonical Hosted Zone ID
read ALB_DNS ALB_ZONE_ID <<< "$(
aws elbv2 describe-load-balancers \
    --load-balancer-arns "$ALB" \
    --query 'LoadBalancers[0].[DNSName,CanonicalHostedZoneId]' \
    --output text
)"

# https://docs.aws.amazon.com/cli/latest/reference/route53/change-resource-record-sets.html
aws route53 change-resource-record-sets \
    --hosted-zone-id "$HOSTED_ZONE_ID" \
    --change-batch "{
        \"Changes\": [
            {
                \"Action\": \"UPSERT\",
                \"ResourceRecordSet\": {
                    \"Name\": \"$FRONTEND_HOST\",
                    \"Type\": \"A\",
                    \"AliasTarget\": {
                        \"HostedZoneId\": \"$ALB_ZONE_ID\",
                        \"DNSName\": \"dualstack.$ALB_DNS\",
                        \"EvaluateTargetHealth\": false
                    }
                }
            },
            {
                \"Action\": \"UPSERT\",
                \"ResourceRecordSet\": {
                    \"Name\": \"$API_HOST\",
                    \"Type\": \"A\",
                    \"AliasTarget\": {
                        \"HostedZoneId\": \"$ALB_ZONE_ID\",
                        \"DNSName\": \"dualstack.$ALB_DNS\",
                        \"EvaluateTargetHealth\": false
                    }
                }
            }
        ]
    }"

echo "Route53 records updated successfully."

#############################################################
# Output Summary
#############################################################
cat <<EOF

==========================================
Deployment Complete
==========================================

Environment : $ENVIRONMENT
ALB DNS     : $ALB_DNS

Frontend TG : $FRONTEND_TG
Backend TG  : $BACKEND_TG

==========================================

EOF