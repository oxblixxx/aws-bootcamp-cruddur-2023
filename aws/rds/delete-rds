#!/bin/bash

set -e

# ─── Config ─────────────────────────────────────────────
DB_INSTANCE_ID="cruddur-db-instance"

# ─── (Optional) Confirm before deleting ─────────────────
read -p "Are you sure you want to DELETE RDS instance '$DB_INSTANCE_ID'? (yes/no): " CONFIRM

if [[ "$CONFIRM" != "yes" ]]; then
  echo "Aborted."
  exit 1
fi

# ─── Disable deletion protection (if enabled) ───────────
echo "Disabling deletion protection (if enabled)..."
aws rds modify-db-instance \
  --db-instance-identifier "$DB_INSTANCE_ID" \
  --no-deletion-protection \
  --apply-immediately

# ─── Delete the DB instance ─────────────────────────────
echo "Deleting RDS instance..."
aws rds delete-db-instance \
  --db-instance-identifier "$DB_INSTANCE_ID" \
  --skip-final-snapshot

echo "Delete request submitted ✔"

# ─── Optional: wait until deleted ───────────────────────
echo "Waiting for DB to be deleted..."
aws rds wait db-instance-deleted \
  --db-instance-identifier "$DB_INSTANCE_ID"

echo "RDS instance deleted successfully ✔"