#!/bin/bash
# https://docs.aws.amazon.com/cli/latest/reference/ecr/create-repository.html
set -e

# Get repo root (2 levels up from backend-flask/bin/task)
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

SERVICE=$1

if [ -z "$SERVICE" ]; then
  echo "Usage: ./task <backend-flask|frontend-react>"
  exit 1
fi

TASK_FILE="$ROOT_DIR/aws/ecr/${SERVICE}.json"

if [ ! -f "$TASK_FILE" ]; then
  echo "Repository definition not found: $TASK_FILE"
  exit 1
fi

echo "Using repository definition: $TASK_FILE"

REPO_NAME=$(jq -r '.repositoryName' "$TASK_FILE")

if aws ecr describe-repositories --repository-names "$REPO_NAME" >/dev/null 2>&1; then
    echo "Repository '$REPO_NAME' already exists."
    exit 0
fi

aws ecr create-repository \
    --cli-input-json file://"$TASK_FILE"

echo "Repository '$REPO_NAME' created successfully."